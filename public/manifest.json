{
  "manifest_version": 3,
  "name": "Altwise",
  "version": "1.0.0",
  "description": "Fixes missing alt text on any page. Gemini Nano reads photos of people on your device; drawings and text go to the cloud.",
  "minimum_chrome_version": "139",
  "action": {
    "default_title": "Open Altwise",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
